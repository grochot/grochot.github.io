@article{karwacki_optimization_2020,
	title = {Optimization of spin {Hall} magnetoresistance in heavy-metal/ferromagnetic-metal bilayers},
	volume = {10},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-020-67450-3},
	doi = {10.1038/s41598-020-67450-3},
	abstract = {Abstract
            
              We present experimental data and their theoretical description on spin Hall magnetoresistance (SMR) in bilayers consisting of a heavy metal (H) coupled to in-plane magnetized ferromagnetic metal (F), and determine contributions to the magnetoresistance due to SMR and anisotropic magnetoresistance (AMR) in five different bilayer systems:
              
                
                  \$\${\textbackslash}hbox \{W\}/{\textbackslash}text \{Co\}\_\{20\}{\textbackslash}text \{Fe\}\_\{60\}{\textbackslash}text \{B\}\_\{20\}\$\$
                  
                    
                      W
                      /
                      
                        Co
                        20
                      
                      
                        Fe
                        60
                      
                      
                        B
                        20
                      
                    
                  
                
              
              ,
              
                
                  \$\${\textbackslash}text \{Co\}\_\{20\}{\textbackslash}text \{Fe\}\_\{60\}{\textbackslash}text \{B\}\_\{20\}/{\textbackslash}hbox \{Pt\}\$\$
                  
                    
                      
                        Co
                        20
                      
                      
                        Fe
                        60
                      
                      
                        B
                        20
                      
                      /
                      Pt
                    
                  
                
              
              ,
              
                
                  \$\${\textbackslash}hbox \{Au\}/{\textbackslash}text \{Co\}\_\{20\}{\textbackslash}text \{Fe\}\_\{60\}{\textbackslash}text \{B\}\_\{20\}\$\$
                  
                    
                      Au
                      /
                      
                        Co
                        20
                      
                      
                        Fe
                        60
                      
                      
                        B
                        20
                      
                    
                  
                
              
              , W/Co, and Co/Pt. The devices used for experiments have different interfacial properties due to either amorphous or crystalline structures of constitutent layers. To determine magnetoresistance contributions and to allow for optimization, the AMR is explicitly included in the diffusion transport equations in the ferromagnets. The results allow determination of different contributions to the magnetoresistance, which can play an important role in optimizing prospective magnetic stray field sensors. They also may be useful in the determination of spin transport properties of metallic magnetic heterostructures in other experiments based on magnetoresistance measurements.},
	language = {en},
	number = {1},
	urldate = {2024-07-14},
	journal = {Scientific Reports},
	author = {Karwacki, Łukasz and Grochot, Krzysztof and Łazarski, Stanisław and Skowroński, Witold and Kanak, Jarosław and Powroźnik, Wiesław and Barnaś, Józef and Stobiecki, Feliks and Stobiecki, Tomasz},
	month = jul,
	year = {2020},
	pages = {10767},
}

